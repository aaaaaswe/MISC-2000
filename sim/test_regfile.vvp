    %vpi_call/w 3 355 "$display", "  Failed: %0d", v0x55c1da8bdde0_0 {0 0 0};
    %vpi_call/w 3 356 "$display", "==============================================" {0 0 0};
    %load/vec4 v0x55c1da8bdde0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_10.6, 4;
    %vpi_call/w 3 359 "$display", "ALL TESTS PASSED" {0 0 0};
    %jmp T_10.7;
T_10.6 ;
    %vpi_call/w 3 361 "$display", "SOME TESTS FAILED" {0 0 0};
T_10.7 ;
    %vpi_call/w 3 364 "$stop" {0 0 0};
    %end;
    .thread T_10;
